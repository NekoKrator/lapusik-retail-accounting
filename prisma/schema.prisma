// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(uuid())
  username           String            @unique
  password           String
  role               String            @default("user") // 'admin' or 'user'
  shifts             Shift[]
  debtors            Debtor[]
  supplierDeliveries SupplierDelivery[]
}

model Supplier {
  id         String             @id @default(uuid())
  name       String             @unique
  deliveries SupplierDelivery[]
}

model SupplierDelivery {
  id            String              @id @default(uuid())
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id])

  totalPrice    Float               // total cost of delivery
  paidByCashier Float   @default(0) // the amount paid by the cashier
  paidByOwner   Float   @default(0) // the amount paid by the owner
  debt          Float   @default(0)

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum PaymentSource {
  CASHIER
  OWNER
}

model Shift {
  id                       String   @id @default(uuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id])

  openedAt                 DateTime  @default(now())
  closedAt                 DateTime?

  isClosed                 Boolean   @default(false)

  openingBalance           Float // cash in register at the start of the day
  additionalBalance        Float? // additional cash receipts
  totalCashRegister        Float? // total income received during the day (cash + card)
  expensesBalance          Float? // total amount of all expenses from breakdown
  calculatedClosingBalance Float? // expected cash counted in register at end of day
  actualClosingBalance     Float? // actual cash counted in register at end of day

  breakdown                ExpensesReportBreakdown? // optional detailed breakdown of expenses and payments
}

model ExpensesReportBreakdown {
  id       String        @id @default(uuid())
  shiftId  String        @unique
  shift    Shift         @relation(fields: [shiftId], references: [id])

  terminalExpenses Float @default(0) // payments made by card (terminal)
  rent             Float @default(0) // rent expenses
  salaries         Float @default(0) // salaries paid
  utilities        Float @default(0) // utility bills
  supplierPayments Float @default(0) // payments made to suppliers
  goodsWriteOff    Float @default(0) // value of inventory written off due to damage, loss, or expiration
  ownerWithdrawal  Float @default(0) // cash withdrawn by owner
  piggyBank        Float @default(0) // amount of cash set aside into the piggy bank (considered an expense)
  otherExpenses    Float @default(0)
}

model Debtor {
  id          String   @id @default(uuid())
  name        String
  currentDebt Float    @default(0)
  totalDebt   Float    @default(0)

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


